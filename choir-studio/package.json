{
  "name": "choir-studio",
  "version": "1.8.0",
  "description": "Offline choir practice with original scores, MIDI playback and independent voice mixing.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/boyang-web/choir-studio.git",
    "directory": "choir-studio"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test --test-isolation=none --test-concurrency=1 tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "build:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "android:sync": "cap sync android"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "jsdom": "^26.1.0",
    "playwright": "^1.56.1"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "tone": "^15.1.22"
  }
}
